# Port cong khai tren may Docker/NAS.
WEB_PORT=8787

# Chi dung khi database chua co bat ky tai khoan nao.
# De trong: he thong tu sinh mat khau va ghi vao data/INITIAL_ADMIN.txt.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

SESSION_DAYS=7
MAX_BACKUP_MB=1024

# HTTP truc tiep: 0. Neu website chi duoc truy cap qua HTTPS reverse proxy: 1.
COOKIE_SECURE=0

# Chi bat 1 khi reverse proxy do ban kiem soat gui X-Forwarded-For dung.
TRUST_PROXY=0
